{
  "name": "opencinema",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Agent 主导的 Go / React 视频画布工作台与 Codex / Claude MCP 插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/junjamrk/OpenCinema.git"
  },
  "bugs": {
    "url": "https://github.com/junjamrk/OpenCinema/issues"
  },
  "homepage": "https://github.com/junjamrk/OpenCinema#readme",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/nodes/*",
    "packages/tools/*"
  ],
  "scripts": {
    "dev": "bun run --filter @toonflow/web --filter @opencinema/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:plugins": "NODE_ENV=production bun run --filter './packages/nodes/*' build",
    "start": "bun run --cwd apps/server start",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd packages/workbenchCore typecheck && bun run --cwd packages/mcp typecheck && bun run --cwd packages/openCinema typecheck && bun run --cwd apps/server typecheck",
    "build:web": "bun run --cwd apps/web build",
    "build:nodes": "NODE_ENV=production bun run --filter './packages/nodes/*' build",
    "build:mcp": "bun run --cwd packages/mcp build",
    "build:server": "bun apps/server/scripts/build.ts",
    "build:plugin": "bun run --cwd packages/openCinema build",
    "build": "bun run build:web && bun run build:nodes && bun run build:mcp && bun run build:server && bun run build:plugin",
    "release": "bun packages/openCinema/scripts/release.ts"
  },
  "devDependencies": {
    "@toonflow/file": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
