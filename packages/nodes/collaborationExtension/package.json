    "@toonflow/nodes-scaffold": "workspace:*",
    "fast-json-patch": "3.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "sass": "^1.104.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
